<Window x:Class="LectureCopilot.Windows.Views.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" Height="148" MinWidth="320" MinHeight="112"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        ShowActivated="False" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Focusable="False" FontFamily="{StaticResource HudText}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Auto"
        TextOptions.TextHintingMode="Fixed">
  <Window.Resources>
    <Style x:Key="SlimScrollBar" TargetType="ScrollBar">
      <Setter Property="Width" Value="6" />
      <Setter Property="Margin" Value="8,2,0,2" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Width="4" HorizontalAlignment="Right" Background="#668C9BAE" CornerRadius="2" />
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
              </Track.IncreaseRepeatButton>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DrawingBrush x:Key="GrainBrush" Viewport="0,0,9,9" ViewportUnits="Absolute" TileMode="Tile">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#10FFFFFF">
            <GeometryDrawing.Geometry>
              <GeometryGroup>
                <EllipseGeometry Center="1.2,1.4" RadiusX="0.45" RadiusY="0.45" />
                <EllipseGeometry Center="6.4,2.8" RadiusX="0.35" RadiusY="0.35" />
                <EllipseGeometry Center="3.8,6.6" RadiusX="0.4" RadiusY="0.4" />
                <EllipseGeometry Center="7.8,7.1" RadiusX="0.3" RadiusY="0.3" />
              </GeometryGroup>
            </GeometryDrawing.Geometry>
          </GeometryDrawing>
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>

    <Style x:Key="Chip" TargetType="Button">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontFamily" Value="{StaticResource HudText}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Height" Value="30" />
      <Setter Property="MinWidth" Value="56" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Shell" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="15" Padding="{TemplateBinding Padding}">
              <Grid>
                <Border Height="12" VerticalAlignment="Top" CornerRadius="15,15,0,0" IsHitTestVisible="False">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                      <GradientStop Color="#14FFFFFF" Offset="0" />
                      <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.88" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.72" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Pill" TargetType="Button">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontFamily" Value="{StaticResource HudText}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Padding" Value="15,0" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Shell" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="{TemplateBinding Padding}">
              <Grid>
                <Border Height="13" VerticalAlignment="Top" CornerRadius="10,10,0,0" IsHitTestVisible="False">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                      <GradientStop Color="#12FFFFFF" Offset="0" />
                      <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.9" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.74" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Foreground" Value="#B3BCC6" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Shell" Width="28" Height="28" CornerRadius="9"
                    Background="#16FFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Shell" Property="Background" Value="#28FFFFFF" />
                <Setter Property="Foreground" Value="#F2F6FA" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Border Margin="18" CornerRadius="26" Background="#02000000" IsHitTestVisible="False">
      <Border.Effect>
        <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.42" Color="#000000" />
      </Border.Effect>
    </Border>

    <Border x:Name="Glass" Margin="18" CornerRadius="26" BorderThickness="1.2" ClipToBounds="True">
      <Border.BorderBrush>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0.15,1">
          <GradientStop Color="#50FFFFFF" Offset="0" />
          <GradientStop Color="#2EFFFFFF" Offset="0.22" />
          <GradientStop Color="#18FFFFFF" Offset="0.72" />
          <GradientStop Color="#10FFFFFF" Offset="1" />
        </LinearGradientBrush>
      </Border.BorderBrush>
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#F2242833" Offset="0" />
          <GradientStop Color="#F2181C24" Offset="0.46" />
          <GradientStop Color="#F214121C" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
      <Grid>
        <Border x:Name="AccentWash" CornerRadius="26" IsHitTestVisible="False" Opacity="0.18">
          <Border.Background>
            <RadialGradientBrush Center="0.18,0" GradientOrigin="0.12,-0.1" RadiusX="0.85" RadiusY="0.7">
              <GradientStop Color="#6685B8FF" Offset="0" />
              <GradientStop Color="#00000000" Offset="1" />
            </RadialGradientBrush>
          </Border.Background>
        </Border>

        <Border CornerRadius="26" IsHitTestVisible="False">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#28FFFFFF" Offset="0" />
              <GradientStop Color="#00FFFFFF" Offset="0.34" />
              <GradientStop Color="#00000000" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
        </Border>

        <Border CornerRadius="26" IsHitTestVisible="False">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#20FFFFFF" Offset="0" />
              <GradientStop Color="#08FFFFFF" Offset="0.18" />
              <GradientStop Color="#00000000" Offset="0.42" />
              <GradientStop Color="#1A000000" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
        </Border>

        <Border Background="{StaticResource GrainBrush}" CornerRadius="26" IsHitTestVisible="False" Opacity="0.12" />

        <Border x:Name="AccentGlow" Width="120" Height="10" CornerRadius="5" HorizontalAlignment="Center"
                VerticalAlignment="Top" Margin="0,-2,0,0" IsHitTestVisible="False" Opacity="0.55">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#0085B8FF" Offset="0" />
              <GradientStop Color="#A685B8FF" Offset="0.5" />
              <GradientStop Color="#0085B8FF" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
        </Border>
        <Border x:Name="AccentLine" Width="72" Height="2" CornerRadius="1" HorizontalAlignment="Center"
                VerticalAlignment="Top" Background="#D085B8FF" IsHitTestVisible="False" />

        <Grid Margin="16,14,12,14">
          <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Width="40" Height="40" VerticalAlignment="Center">
              <Border CornerRadius="14" Background="#18000000" Margin="1,2,0,0" />
              <Border x:Name="IconBadge" CornerRadius="14" BorderThickness="1"
                      BorderBrush="#66FFFFFF">
                <Border.Background>
                  <ImageBrush ImageSource="/Assets/HUDIcon.png" Stretch="UniformToFill" />
                </Border.Background>
              </Border>
              <Border x:Name="StatusDotGlow" Width="12" Height="12" CornerRadius="6"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Margin="0,0,-2,-2" Background="#5585B8FF" IsHitTestVisible="False" />
              <Border x:Name="StatusDot" Width="8" Height="8" CornerRadius="4"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Margin="0,0,-1,-1" BorderThickness="1.6" BorderBrush="#E012141C"
                      Background="#85B8FF" />
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,10,0">
              <TextBlock x:Name="Eyebrow" Text="LECTURE COPILOT" Foreground="#AEB6C0"
                         FontSize="10" FontWeight="SemiBold" FontFamily="{StaticResource HudText}"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="TitleText" Text="Start Class" Foreground="#F7F8FA" FontSize="18"
                         FontWeight="SemiBold" FontFamily="{StaticResource HudDisplay}"
                         TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
            </StackPanel>

            <Border x:Name="ModeChip" Grid.Column="2" Height="30" CornerRadius="15" BorderThickness="1"
                    Padding="12,0" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed"
                    Background="#246BDBC0" BorderBrush="#726BDBC0" Cursor="Hand"
                    MouseLeftButtonUp="ModeChipClicked">
              <TextBlock x:Name="ModeLabel" Text="Ready" Foreground="#C5F6E4" FontSize="13"
                         FontWeight="SemiBold" FontFamily="{StaticResource HudText}"
                         VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>

            <Button x:Name="SessionChip" Grid.Column="3" Style="{StaticResource Chip}" Margin="0,0,8,0"
                    Visibility="Collapsed" Click="SessionChipClicked" />

            <Button Grid.Column="4" x:Name="CloseButton" Style="{StaticResource IconButton}"
                    Content="✕" Click="CloseClicked" VerticalAlignment="Center" />
          </Grid>

          <Border x:Name="Hairline" Grid.Row="1" Height="1" Margin="2,10,2,0" Visibility="Collapsed">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#00FFFFFF" Offset="0" />
                <GradientStop Color="#2EFFFFFF" Offset="0.2" />
                <GradientStop Color="#2EFFFFFF" Offset="0.8" />
                <GradientStop Color="#00FFFFFF" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>

          <Border x:Name="DetailWell" Grid.Row="2" Margin="1,12,1,0" CornerRadius="16" BorderThickness="1"
                  Visibility="Collapsed" BorderBrush="#1AFFFFFF">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#28000000" Offset="0" />
                <GradientStop Color="#3A000000" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
            <ScrollViewer x:Name="DetailScroller" Margin="16,14" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}" />
              </ScrollViewer.Resources>
              <StackPanel x:Name="DetailContent" />
            </ScrollViewer>
          </Border>

          <StackPanel Grid.Row="3" x:Name="FooterActions" Orientation="Horizontal" Margin="2,12,2,2"
                      Visibility="Collapsed" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
