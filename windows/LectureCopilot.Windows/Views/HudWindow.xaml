<Window x:Class="LectureCopilot.Windows.Views.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="790" Height="112" MinWidth="560" MinHeight="100"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        FontFamily="{StaticResource AppFont}">
  <Window.Resources>
    <Style x:Key="Pill" TargetType="Button">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Padding" Value="17,8" />
      <Setter Property="Margin" Value="5,0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Shell" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="18" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.82" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.62" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="Glass" CornerRadius="28" BorderThickness="1.2" BorderBrush="#5B7190A8">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F02D3541" Offset="0" />
        <GradientStop Color="#F0202832" Offset="0.58" />
        <GradientStop Color="#F02A2430" Offset="1" />
      </LinearGradientBrush>
    </Border.Background>
    <Border.Effect><DropShadowEffect BlurRadius="32" ShadowDepth="8" Opacity="0.48" Color="#120F18" /></Border.Effect>
    <Grid Margin="18,13,15,14">
      <Grid.RowDefinitions>
        <RowDefinition Height="74" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="66" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="52" />
        </Grid.ColumnDefinitions>
        <Border Width="58" Height="58" CornerRadius="19" BorderBrush="#668EBEFF" BorderThickness="1.5"
                Background="#303F5570" VerticalAlignment="Center">
          <Image Source="/Assets/HUDIcon.png" Width="32" Height="32" Stretch="Uniform" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0">
          <TextBlock x:Name="Eyebrow" Text="LECTURE COPILOT" Foreground="#BAC2CC" FontSize="12.5"
                     FontWeight="SemiBold" />
          <TextBlock x:Name="TitleText" Text="Start Class" Foreground="White" FontSize="25"
                     FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel x:Name="HeaderActions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" />
        <Button Grid.Column="3" x:Name="CloseButton" Width="43" Height="43" Margin="5,0,0,0"
                Style="{StaticResource Pill}" Padding="0" Background="#29323C46" BorderBrush="#1FFFFFFF"
                FontSize="22" FontWeight="Light" Content="×" Click="CloseClicked" />
      </Grid>

      <ScrollViewer Grid.Row="1" x:Name="DetailScroller" MaxHeight="230" Margin="12,15,12,8"
                    VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <TextBlock x:Name="DetailText" Foreground="#EDF1F6" FontSize="17" LineHeight="27"
                   TextWrapping="Wrap" Text="Ready." />
      </ScrollViewer>

      <StackPanel Grid.Row="2" x:Name="FooterActions" Orientation="Horizontal" HorizontalAlignment="Right"
                  Margin="8,10,8,0" Visibility="Collapsed" />
    </Grid>
  </Border>
</Window>
